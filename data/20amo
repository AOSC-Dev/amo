// Notify amo after package/repository state changes. The call blocks until
// amo's search index is refreshed (bounded by --timeout); on timeout the
// refresh continues in the background and queries wait for it, so callers
// never see stale results. Hook failures must not fail APT.

APT::Update::Post-Invoke-Success {
    "/usr/bin/busctl --system --quiet --timeout=4 call io.aosc.Amo /io/aosc/Amo io.aosc.Amo1 InvalidateCache >/dev/null 2>&1 || true";
};

DPkg::Post-Invoke {
    "/usr/bin/busctl --system --quiet --timeout=4 call io.aosc.Amo /io/aosc/Amo io.aosc.Amo1 InvalidateCache >/dev/null 2>&1 || true";
};
